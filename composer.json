{
  "name": "momokoudai/geoip-local",
  "description": "Local GeoIP data source + location display integration for fof/geoip",
  "type": "flarum-extension",
  "license": "MIT",
  "version": "0.0.3",
  "require": {
    "php": "^8.0",
    "flarum/core": "^1.8.0",
    "fof/geoip": "^1.5.3",
    "guzzlehttp/guzzle": "^7.3",
    "geoip2/geoip2": "^2.13",
    "ip2location/ip2location-php": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "momokoudai\\GeoipLocal\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "GeoIP Local",
      "category": "feature",
      "icon": {
        "name": "fas fa-map-marker-alt",
        "backgroundColor": "#1f6feb",
        "color": "#fff"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
